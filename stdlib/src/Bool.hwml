// Bool: The boolean type
// Represents truth values with two constructors: true and false

inductive Std.Bool : Type := {
    | true : Bool
    | false : Bool
}

namespace Std.Bool {

// Boolean negation
def not (b : Bool) : Bool :=
    b match {
    | true => false
    | false => true
    }

// Boolean AND
def and (a b : Bool) : Bool :=
    a match {
    | true => b
    | false => false
    }

// Boolean OR
def or (a b : Bool) : Bool :=
    a match {
    | true => true
    | false => b
    }

// Boolean XOR
def xor (a b : Bool) : Bool :=
    a match {
    | true => not b
    | false => b
    }

// Boolean NAND
def nand (a b : Bool) : Bool :=
    not (and a b)

// Boolean NOR
def nor (a b : Bool) : Bool :=
    not (or a b)

// Boolean equality
def eq (a b : Bool) : Bool :=
    a match {
    | true => b
    | false => not b
    }

// Conditional/if-then-else
// Given a boolean and two values, return the first if true, second if false
def ite (A : Type) (cond : Bool) (then_branch : A) (else_branch : A) : A :=
    cond match {
    | true => then_branch
    | false => else_branch
    }
}
