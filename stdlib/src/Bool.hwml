// Bool: The boolean type
// Represents truth values with two constructors: true and false

inductive Std.Bool : Type where
    | true : Bool
    | false : Bool

namespace Std.Bool {

// Boolean negation
def not (b : Bool) : Bool :=
    match b with
    | true ~> false
    | false ~> true
    end

// Boolean AND
def and (a : Bool) (b : Bool) : Bool :=
    match a with
    | true ~> b
    | false ~> false
    end

// Boolean OR
def or (a : Bool) (b : Bool) : Bool :=
    match a with
    | true ~> true
    | false ~> b
    end

// Boolean XOR
def xor (a : Bool) (b : Bool) : Bool :=
    match a with
    | true ~> not b
    | false ~> b
    end

// Boolean NAND
def nand (a : Bool) (b : Bool) : Bool :=
    not (and a b)

// Boolean NOR
def nor (a : Bool) (b : Bool) : Bool :=
    not (or a b)

// Boolean equality
def eq (a : Bool) (b : Bool) : Bool :=
    match a with
    | true ~> b
    | false ~> not b
    end

// Conditional/if-then-else
// Given a boolean and two values, return the first if true, second if false
def ite (A : Type) (cond : Bool) (then_branch : A) (else_branch : A) : A :=
    match cond with
    | true ~> then_branch
    | false ~> else_branch
    end
}