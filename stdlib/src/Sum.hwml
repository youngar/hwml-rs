// Sum: Sum type (disjoint union / Either)
//
// Updated to use implicit arguments for type parameters.
// Usage: elim f g my_sum  (instead of: elim Nat Bool String f g my_sum)

inductive Std.Sum (A : Type) (B : Type) : Type := {
    | inl : A -> Sum A B
    | inr : B -> Sum A B
}

namespace Std.Sum {

// Check if sum is left
def is_left {A : Type} {B : Type} (s : Sum A B) : Bool :=
    s match {
    | inl _ => true
    | inr _ => false
    }

// Check if sum is right
def is_right {A : Type} {B : Type} (s : Sum A B) : Bool :=
    s match {
    | inl _ => false
    | inr _ => true
    }

// Case analysis / elimination
def elim {A : Type} {B : Type} {C : Type}
         (f : A -> C) (g : B -> C) (s : Sum A B) : C :=
    s match {
    | inl a => f a
    | inr b => g b
    }

// Map over the left type
def map_left {A : Type} {B : Type} {C : Type}
             (f : A -> C) (s : Sum A B) : Sum C B :=
    s match {
    | inl a => inl (f a)
    | inr b => inr b
    }

// Map over the right type
def map_right {A : Type} {B : Type} {D : Type}
              (g : B -> D) (s : Sum A B) : Sum A D :=
    s match {
    | inl a => inl a
    | inr b => inr (g b)
    }

// Map over both types
def bimap {A : Type} {B : Type} {C : Type} {D : Type}
          (f : A -> C) (g : B -> D) (s : Sum A B) : Sum C D :=
    s match {
    | inl a => inl (f a)
    | inr b => inr (g b)
    }

// Swap left and right
def swap {A : Type} {B : Type} (s : Sum A B) : Sum B A :=
    s match {
    | inl a => inr a
    | inr b => inl b
    }

}
