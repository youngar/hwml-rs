// Option: The maybe/optional type
// Represents a value that may or may not be present

// The Option type itself lives in Std namespace
inductive Std.Option (A : Type) : Type := {
    | none : Option A
    | some : A -> Option A
}

namespace Std.Option {

// Check if an option is None
def is_none (A : Type) (opt : Option A) : Bool :=
    match opt {
    | none => true
    | some _ => false
    }

// Check if an option is Some
def is_some (A : Type) (opt : Option A) : Bool :=
    match opt {
    | none => false
    | some _ => true
    }

// Map a function over an option
def map (A : Type) (B : Type) (f : A -> B) (opt : Option A) : Option B :=
    match opt {
    | none => none
    | some x => some (f x)
    }

// Get the value from Some, or return a default for None
def get_or_else (A : Type) (default : A) (opt : Option A) : A :=
    match opt {
    | none => default
    | some x => x
    }

// Bind operation (monadic bind)
def bind (A : Type) (B : Type) (opt : Option A) (f : A -> Option B) : Option B :=
    match opt {
    | none => none
    | some x => f x
    }

// Flatten a nested option
def flatten (A : Type) (opt : Option (Option A)) : Option A :=
    match opt {
    | none => none
    | some inner => inner
    }

// Filter: returns None if predicate is false
def filter (A : Type) (p : A -> Bool) (opt : Option A) : Option A :=
    match opt {
    | none => none
    | some x =>
        match p x {
        | true => some x
        | false => none
        }
    }

}
