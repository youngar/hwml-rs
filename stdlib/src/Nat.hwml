// Nat: Natural numbers using Peano encoding

inductive Std.Nat : Type := {
    | zero : Nat
    | succ : Nat -> Nat
}

namespace Std.Nat {

// Convenient aliases for small numbers
def one : Nat := succ zero
def two : Nat := succ one
def three : Nat := succ two
def four : Nat := succ three
def five : Nat := succ four

// Addition
def add (m : Nat) (n : Nat) : Nat :=
    match m {
    | zero => n
    | succ m' => succ (add m' n)
    }

// Multiplication
def mul (m : Nat) (n : Nat) : Nat :=
    match m {
    | zero => zero
    | succ m' => add n (mul m' n)
    }

// Predecessor (returns zero for zero)
def pred (n : Nat) : Nat :=
    match n {
    | zero => zero
    | succ n' => n'
    }

// Subtraction (saturating at zero)
def sub (m : Nat) (n : Nat) : Nat :=
    match n {
    | zero => m
    | succ n' => sub (pred m) n'
    }

// Check if a number is zero
def is_zero (n : Nat) : Std.Bool :=
    match n {
    | zero => Std.true
    | succ _ => Std.false
    }

// Equality test
def eq (m : Nat) (n : Nat) : Std.Bool :=
    match m {
    | zero => is_zero n
    | succ m' =>
        match n {
        | zero => Std.false
        | succ n' => eq m' n'
        }
    }

// Less than or equal
def le (m n : Nat) : Std.Bool :=
    match m {
    | zero => Std.true
    | succ m' =>
        match n {
        | zero => Std.false
        | succ n' => le m' n'
        }
    }

// Less than
def lt (m : Nat) (n : Nat) : Std.Bool :=
    Std.Bool.and (le m n) (Std.Bool.not (eq m n))

// Greater than or equal
def ge (m : Nat) (n : Nat) : Std.Bool :=
    le n m

// Greater than
def gt (m : Nat) (n : Nat) : Std.Bool :=
    lt n m

// Minimum of two naturals
def min (m : Nat) (n : Nat) : Nat :=
    Std.Bool.ite Nat (le m n) m n

// Maximum of two naturals
def max (m : Nat) (n : Nat) : Nat :=
    Std.Bool.ite Nat (le m n) n m

// Power (exponentiation)
def pow (base : Nat) (exp : Nat) : Nat :=
    match exp {
    | zero => one
    | succ exp' => mul base (pow base exp')
    }

}
